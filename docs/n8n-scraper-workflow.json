      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "jsCode": "// Construir registro para tabla `precios`\nconst scraper = $('Code · parser por mercado').item.json\nconst ingrediente = $input.first().json\nconst mercado = $('Split · un mercado a la vez').item.json\n\nconst precio = scraper.precio_kg ?? ((scraper.precio_min + scraper.precio_max) / 2)\n\nreturn [{\n  json: {\n    ingrediente: [ingrediente.id],\n    mercado: [mercado.id],\n    fecha: scraper.fecha,\n    precio_kg: precio,\n    precio_min: scraper.precio_min,\n    precio_max: scraper.precio_max,\n    unidad: scraper.unidad,\n    calibre: scraper.calibre,\n    origen: scraper.origen,\n    procedencia_scraper: `n8n_${$workflow.id}_${new Date().toISOString().slice(0,10)}`\n  }\n}]\n"
      },
