      "id": "http-fetch",
      "name": "HTTP · descarga página mercado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parser genérico — delega por mercado\nconst cheerio = require('cheerio')\nconst mercado = $('Split · un mercado a la vez').item.json.nombre\nconst html = $input.first().json.data || $input.first().json.body\n\nconst fecha = new Date().toISOString().split('T')[0]\n\nfunction parseMercabarna(html) {\n  const $ = cheerio.load(html)\n  const rows = []\n  $('table.precios tr, table.tabla-precios tr').each((_, tr) => {\n    const cols = $(tr).find('td').map((_, td) => $(td).text().trim()).get()\n    if (cols.length < 4 || !cols[1]) return\n    rows.push({\n      nombre_scraper: cols[1],\n      precio_min: parseFloat((cols[2] || '').replace(',', '.')) || null,\n      precio_max: parseFloat((cols[3] || '').replace(',', '.')) || null,\n      precio_kg: cols[4] ? parseFloat(cols[4].replace(',', '.')) : null,\n      unidad: cols[5] || 'kg',\n      origen: cols[6] || null,\n      calibre: cols[7] || null,\n      fecha\n    })\n  })\n  return rows\n}\n\n// Placeholder para otros mercados — completar según formato real\nfunction parseMercamadrid(html) { return parseMercabarna(html) }\nfunction parseMercavalencia(html) { return parseMercabarna(html) }\nfunction parseMercabilbao(html) { return parseMercabarna(html) }\nfunction parseMercasevilla(html) { return parseMercabarna(html) }\n\nconst parsers = { mercabarna: parseMercabarna, mercamadrid: parseMercamadrid, mercavalencia: parseMercavalencia, mercabilbao: parseMercabilbao, mercasevilla: parseMercasevilla }\nif (!parsers[mercado]) throw new Error(`Sin parser para ${mercado}`)\n\nreturn parsers[mercado](html).map(row => ({ json: { ...row, mercado_slug: mercado } }))\n"
      },
      "id": "parser-router",
      "name": "Code · parser por mercado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "authentication": "airtableTokenApi",
