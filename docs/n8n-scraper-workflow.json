          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "ingredientes",
          "mode": "name"
        },
        "filterByFormula": "=OR(LOWER({nombre}) = LOWER('{{ $json.nombre_scraper.replace(/'/g, \"\\\\'\") }}'), FIND(LOWER('{{ $json.nombre_scraper.replace(/'/g, \"\\\\'\") }}'), LOWER({sinonimos_scraper})) > 0)",
        "options": {
          "returnAll": false,
          "limit": 1
        }
      },
